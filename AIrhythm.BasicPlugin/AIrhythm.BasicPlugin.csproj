<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\AIrhythm.Version.props" />
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;x64</Platforms>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <Prefer32Bit>false</Prefer32Bit>
    <AIrhythmDeveloperDiagnostics Condition="'$(AIrhythmDeveloperDiagnostics)' == ''">$(TvAIrDeveloperDiagnostics)</AIrhythmDeveloperDiagnostics>
    <RootNamespace>AIrhythm.BasicPlugin</RootNamespace>
    <AssemblyName>AIrhythm.BasicPlugin</AssemblyName>
    <Version>$(AIrhythmVersion)</Version>
    <FileVersion>$(AIrhythmVersion).0</FileVersion>
    <AssemblyVersion>$(AIrhythmVersion).0</AssemblyVersion>
    <InformationalVersion>$(AIrhythmVersion)</InformationalVersion>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AIrhythmDeveloperDiagnostics)'=='true'">
    <DefineConstants>$(DefineConstants);AIRHYTHM_DEVELOPER_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <!-- One canonical build switch. A divergent override must never silently ship diagnostics. -->
  <Target Name="ValidateAIrhythmDiagnosticsBoundary" BeforeTargets="CoreCompile">
    <Error Condition="'$(AIrhythmDeveloperDiagnostics)' != '$(TvAIrDeveloperDiagnostics)'"
           Text="AI-rhythm and SDK Developer Diagnostics flags must match. Use TvAIrDeveloperDiagnostics only." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\TvAIrPlugin\TvAIrPlugin.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" />
  </ItemGroup>
</Project>
